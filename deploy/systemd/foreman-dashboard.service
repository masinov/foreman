[Unit]
Description=Foreman dashboard
Documentation=file://@REPO@/docs/MANUAL.md
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@REPO@
# The PATH of the person who installed the unit: a user unit's own PATH
# lacks ~/.local/bin, where `claude` usually is, and every agent step would
# fail with "executable `claude` was not found".
Environment="PATH=@PATH@"
ExecStart=@FOREMAN@ dashboard
Restart=always
RestartSec=30
TimeoutStopSec=30

[Install]
WantedBy=default.target
