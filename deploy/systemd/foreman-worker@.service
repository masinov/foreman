[Unit]
Description=Foreman worker for project %i
Documentation=file://@REPO@/docs/MANUAL.md
# Give up after 10 starts in 10 minutes (a fault that does not pass, such as
# a database that needs `foreman db migrate`): the dashboard then says "no worker"
# and offers Restart (ADR-0043).
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@REPO@
# The PATH of the person who installed the unit: a user unit's own PATH
# lacks ~/.local/bin, where `claude` usually is, and every agent step would
# fail with "executable `claude` was not found".
Environment="PATH=@PATH@"
ExecStart=@FOREMAN@ serve %i
# `foreman serve` exits 0 when asked to stop (`foreman engine shutdown`), and
# the work is paused, not the engine, so a worker that ended is started again.
Restart=always
# Thirty seconds apart: a worker killed hard holds the project's engine lease
# for up to two minutes, and the starts before it expires fail. Ten starts
# at this spacing outlast it well before the start limit.
RestartSec=30
# A killed worker leaves no agent behind (the worker sees to that); this also
# makes systemd end anything left in the unit's control group before a restart.
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=default.target
