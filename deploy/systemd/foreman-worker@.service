[Unit]
Description=Foreman worker for project %i
Documentation=file://@REPO@/docs/MANUAL.md
# Give up after 10 starts in 10 minutes: the dashboard then says "no worker"
# and offers Restart (ADR-0043).
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@FOREMAN@ serve %i
# `foreman serve` exits 0 when asked to stop (`foreman engine shutdown`), and
# the work is paused, not the engine, so a worker that ended is started again.
Restart=always
RestartSec=10
# A killed worker leaves no agent behind (the worker sees to that); this also
# makes systemd end anything left in the unit's control group before a restart.
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=default.target
